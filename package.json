{
  "name": "pardon-my-trade",
  "version": "0.2.0",
  "private": true,
  "description": "Recommendation-only fantasy sports general manager (MVP + V1).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean.ps1",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "serve": "npm run build && npm run pmt -- serve",
    "refresh": "npm run build && npm run pmt -- refresh",
    "model:qb-wr": "python3 python/chatpft_modeling/train_qb_wr.py --output artifacts/qb-wr-models",
    "model:qb-wr:real": "python3 python/chatpft_modeling/train_real_qb_wr.py --data-dir data --output artifacts/qb-wr-models-real",
    "verify:fixture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-fixture.ps1",
    "pmt": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
