{
  "name": "pardon-my-trade",
  "version": "0.2.0",
  "private": true,
  "description": "Recommendation-only fantasy sports general manager (MVP + V1).",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', {recursive:true, force:true})\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "serve": "npm run build && npm run pmt -- serve",
    "test:draft-interactive": "npm run build && node scripts/interactive-draft-harness-test.mjs",
    "refresh": "npm run build && npm run pmt -- refresh",
    "verify:fixture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-fixture.ps1",
    "pmt": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ws": "^8.18.0"
  }
}
