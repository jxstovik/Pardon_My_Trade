{
  "name": "pardon-my-trade",
  "version": "0.2.0",
  "private": true,
  "description": "Recommendation-only fantasy sports general manager (MVP + V1).",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', {recursive:true, force:true})\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "serve": "npm run build && npm run pmt -- serve",
    "test:draft-interactive": "npm run build && node scripts/interactive-draft-harness-test.mjs",
    "refresh": "npm run build && npm run pmt -- refresh",
    "model:qb-wr": "python3 python/chatpft_modeling/train_qb_wr.py --output artifacts/qb-wr-models",
    "model:qb-wr:real": "python3 python/chatpft_modeling/train_real_qb_wr.py --data-dir data --output artifacts/qb-wr-models-real",
    "model:wr:replay": "python3 python/chatpft_modeling/replay_wr_2024.py --data-dir data --output artifacts/wr-2024-replay",
    "model:wr:walkforward": "python3 python/chatpft_modeling/walkforward_wr_2024.py --data-dir data --output artifacts/wr-2024-replay",
    "model:qb:replay": "python3 python/chatpft_modeling/replay_wr_2024.py --position QB --data-dir data --output artifacts/qb-2024-replay",
    "model:qb:walkforward": "python3 python/chatpft_modeling/walkforward_wr_2024.py --position QB --data-dir data --output artifacts/qb-2024-replay",
    "model:rb:replay": "python3 python/chatpft_modeling/replay_wr_2024.py --position RB --data-dir data --output artifacts/rb-2024-replay",
    "model:rb:walkforward": "python3 python/chatpft_modeling/walkforward_wr_2024.py --position RB --data-dir data --output artifacts/rb-2024-replay",
    "model:te:replay": "python3 python/chatpft_modeling/replay_wr_2024.py --position TE --data-dir data --output artifacts/te-2024-replay",
    "model:te:walkforward": "python3 python/chatpft_modeling/walkforward_wr_2024.py --position TE --data-dir data --output artifacts/te-2024-replay",
    "model:2026:qb": "python3 python/chatpft_modeling/preseason_2026.py --position QB --data-dir data --output artifacts/qb-2026-preseason",
    "model:2026:rb": "python3 python/chatpft_modeling/preseason_2026.py --position RB --data-dir data --output artifacts/rb-2026-preseason",
    "model:2026:wr": "python3 python/chatpft_modeling/preseason_2026.py --position WR --data-dir data --output artifacts/wr-2026-preseason",
    "model:2026:te": "python3 python/chatpft_modeling/preseason_2026.py --position TE --data-dir data --output artifacts/te-2026-preseason",
    "verify:fixture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-fixture.ps1",
    "pmt": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ws": "^8.18.0"
  }
}
