+  assert.equal(projection?.player_id, "canonical-1");
+  assert.equal(projection?.scoring_period, "2026-W4");
+  assert.equal(projection?.created_at, "2026-09-30T20:00:00.000Z");
+});
+
+test("name fallback skips ambiguous matches", () => {
+  const players = [player("one", "Jordan Example", "NYG"), player("two", "Jordan Example", "DAL")];
+  const projections = matchProjectionsToRoster([{
+    name: "Jordan Example", team: "GB", positions: ["WR"], projected_stats: {},
+    projected_points: 10, floor: 7, ceiling: 13, confidence: 0.5
+  }], players, "2026-W4", "espn");
+  assert.deepEqual(projections, []);
+});
+
+test("weekly period matching accepts W4/W04 equivalence and rejects a different source week", () => {
+  const base: ProjectionCandidate = { name: "Weekly Player", team: "SF", positions: ["RB"], projected_stats: {}, projected_points: 10, floor: 5, ceiling: 15, confidence: 0.7 };
+  const roster = [player("weekly", "Weekly Player", "SF")];
+  const matched = matchProjectionsToRoster([{ ...base, scoring_period: "2026-W04" }], roster, "2026-W4", "espn");
+  assert.equal(matched[0]?.scoring_period, "2026-W4");
+  assert.equal(matchProjectionsToRoster([{ ...base, scoring_period: "2026-W5" }], roster, "2026-W4", "espn").length, 0);
+});
diff --git a/tests/reliability-sqlite.test.ts b/tests/reliability-sqlite.test.ts
new file mode 100644
index 0000000..d546ab0
--- /dev/null
+++ b/tests/reliability-sqlite.test.ts
@@ -0,0 +1,105 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtempSync, rmSync } from "node:fs";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { ActionQueue, SqliteActionQueueStore } from "../src/agents/action-queue.js";
+import { SqliteActionExecutionStore } from "../src/agents/action-executor.js";
+import { SqliteJobStore } from "../src/storage/sqlite-job-store.js";
+import { loadRuntimeConfig } from "../src/config/runtime-config.js";
+import { SqliteKnowledgeRepository } from "../src/knowledge/sqlite-knowledge-repository.js";
+import { makeSnapshot } from "./test-builders.js";
+
+test("SQLite receipt reservation lets only one process reserve an action", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "pmt-receipt-"));
+  const filePath = join(dir, "pmt.sqlite");
+  const first = new SqliteActionExecutionStore(filePath);
+  const second = new SqliteActionExecutionStore(filePath);
+  const receipt = {
+    receiptId: "rcpt-one", actionId: "act-one", idempotencyKey: "key-one", payloadHash: "hash-one",
+    status: "unknown" as const, recordedAt: new Date().toISOString()
+  };
+  try {
+    const results = await Promise.all([first.reserveReceipt(receipt), second.reserveReceipt(receipt)]);
+    assert.deepEqual(results.sort(), [false, true]);
+    assert.equal((await first.getReceipt("act-one"))?.status, "unknown");
+  } finally {
+    first.close(); second.close(); await rm(dir, { recursive: true, force: true });
+  }
+});
+
+test("SQLite queue compare-and-swap prevents a stale pending transition", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "pmt-queue-"));
+  const filePath = join(dir, "pmt.sqlite");
+  const first = new SqliteActionQueueStore(filePath);
+  const second = new SqliteActionQueueStore(filePath);
+  try {
+    const queue = new ActionQueue(first);
+    const action = { type: "set_roster" as const, teamId: "team-1", starters: [] };
+    const queued = await queue.enqueue(action, "low", "test", { preconditions: { leagueExternalId: "league-1", scoringPeriod: "2026-W01" } });
+    const duplicate = await new ActionQueue(second).enqueue(action, "low", "same proposal", { preconditions: { leagueExternalId: "league-1", scoringPeriod: "2026-W01" } });
+    assert.equal(duplicate.actionId, queued.actionId);
+    const updated = { ...queued, status: "approved" as const, approvedBy: "reviewer" };
+    assert.equal(await first.compareAndSwap!(queued.actionId, "pending", updated), true);
+    assert.equal(await second.compareAndSwap!(queued.actionId, "pending", { ...queued, status: "rejected" }), false);
+    assert.equal((await second.get(queued.actionId))?.status, "approved");
+  } finally {
+    first.close(); second.close(); await rm(dir, { recursive: true, force: true });
+  }
+});
+
+test("durable job claims are exclusive and expired leases can be recovered", () => {
+  const dir = mkdtempSync(join(tmpdir(), "pmt-jobs-"));
+  const filePath = join(dir, "pmt.sqlite");
+  const first = new SqliteJobStore({ filePath });
+  const second = new SqliteJobStore({ filePath });
+  try {
+    const now = new Date("2026-10-01T12:00:00.000Z");
+    const queued = first.enqueue("refresh", { league: "league-1" }, { dedupeKey: "league-1:2026-W01", availableAt: now });
+    const claim = first.claimJob(queued.jobId, "worker-a", { leaseMs: 30_000, now });
+    assert.equal(claim?.status, "running");
+    assert.equal(second.claimJob(queued.jobId, "worker-b", { now }), undefined);
+    const recovered = second.claimJob(queued.jobId, "worker-b", { now: new Date(now.getTime() + 30_001) });
+    assert.equal(recovered?.leaseOwner, "worker-b");
+    assert.equal(recovered?.attempts, 2);
+    assert.equal(second.complete(queued.jobId, "worker-b", { snapshotId: "snap-1" }), true);
+    assert.deepEqual(second.get(queued.jobId)?.result, { snapshotId: "snap-1" });
+  } finally {
+    first.close(); second.close(); rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("runtime config selects explicit ESPN identity and rejects missing live team", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "pmt-runtime-"));
+  try {
+    const config = loadRuntimeConfig({ PMT_DATA_DIR: dir, ESPN_LEAGUE_ID: " 123 ", PMT_TEAM_ID: " team-8 " });
+    assert.equal(config.platform, "espn");
+    assert.equal(config.leagueExternalId, "123");
+    assert.equal(config.teamExternalId, "team-8");
+    assert.equal(config.databasePath, join(dir, "pmt.sqlite"));
+    assert.throws(() => loadRuntimeConfig({ PMT_PLATFORM: "espn", PMT_LEAGUE_ID: "league-1", PMT_TEAM_ID: " " }), /team id is required/i);
+  } finally { await rm(dir, { recursive: true, force: true }); }
+});
+
+test("SQLite latest pointer advances transactionally and refuses a second live league", async () => {
+  const repository = new SqliteKnowledgeRepository({ memory: true });
+  try {
+    const fixture = makeSnapshot([], { snapshotId: "fixture", season: "2026" });
+    await repository.saveLeagueSnapshot(fixture);
+    const live = {
+      ...makeSnapshot([], { snapshotId: "live-1", season: "2026" }),
+      league: { ...fixture.league, platform: "espn" as const, external_id: "espn-100", league_id: "espn-100" }
+    };
+    await repository.saveLeagueSnapshot(live);
+    assert.equal((await repository.getLatestLeagueSnapshot())?.snapshot_id, "live-1");
+    const otherLive = {
+      ...live,
+      snapshot_id: "live-2",
+      league: { ...live.league, external_id: "espn-200", league_id: "espn-200" }
+    };
+    await assert.rejects(() => repository.saveLeagueSnapshot(otherLive), /already contains live/i);
+    await repository.saveLeagueSnapshot({ ...fixture, snapshot_id: "fixture-2" });
+    assert.equal((await repository.getLatestLeagueSnapshot())?.snapshot_id, "live-1");
+  } finally { repository.close(); }
+});
diff --git a/tests/roster-analytics.test.ts b/tests/roster-analytics.test.ts
new file mode 100644
index 0000000..1be5a52
--- /dev/null
+++ b/tests/roster-analytics.test.ts
@@ -0,0 +1,131 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import type { LeagueSnapshot, PlayerPosition } from "../src/models/types.js";
+import { buildRosterAnalytics, simulateFreeAgentScenario } from "../src/application/roster-analytics.js";
+import { optimizeLineup } from "../src/agents/skills/lineup-optimizer.js";
+import { createModel } from "../src/probabilistic/bayesian-model.js";
+
+async function completeProjectionSnapshot(): Promise<LeagueSnapshot> {
+  const raw = await readFile(resolve("tests/fixtures/sample-football-league.json"), "utf8");
+  const snapshot = JSON.parse(raw) as LeagueSnapshot;
+  const allPlayers = [...snapshot.players, ...snapshot.free_agents];
+  const projections = allPlayers.map((player) => ({
+    schema_version: "1.0.0",
+    created_at: "2026-09-01T00:00:00.000Z",
+    updated_at: "2026-09-01T00:00:00.000Z",
+    source_system: "test",
+    source_record_id: `test-${player.player_id}`,
+    projection_id: `test-${player.player_id}-2026-W01`,
+    player_id: player.player_id,
+    source: "test-weekly",
+    scoring_period: "2026-W01",
+    projected_stats: {},
+    projected_points: player.player_id === "fa-rb-001" ? 40 : 10,
+    floor: player.player_id === "fa-rb-001" ? 25 : 0,
+    ceiling: player.player_id === "fa-rb-001" ? 55 : 20,
+    confidence: 0.9
+  }));
+  return { ...snapshot, projections };
+}
+
+test("roster analytics returns repeatable distributions and coverage histograms", async () => {
+  const snapshot = await completeProjectionSnapshot();
+  const dir = await mkdtemp(join(tmpdir(), "pmt-roster-analytics-"));
+  try {
+    const first = await buildRosterAnalytics(snapshot, "team-001", { period: "2026-W01", samples: 80, seed: 42, dataDir: dir });
+    const second = await buildRosterAnalytics(snapshot, "team-001", { period: "2026-W01", samples: 80, seed: 42, dataDir: dir });
+    assert.equal(first.metadata.snapshotId, snapshot.snapshot_id);
+    assert.equal(first.lineups.optimized.distribution.samples, 80);
+    assert.deepEqual(first.lineups.optimized.distribution, second.lineups.optimized.distribution);
+    assert.equal(first.lineups.optimized.distribution.histogram.reduce((sum, bucket) => sum + bucket.count, 0), 80);
+    assert.equal(first.freeAgents.coverage.uncovered, 0);
+    assert.equal(first.roster.current?.samples, 80);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
+
+test("scenario compares an add/drop on paired seeded outcomes", async () => {
+  const snapshot = await completeProjectionSnapshot();
+  const dir = await mkdtemp(join(tmpdir(), "pmt-roster-scenario-"));
+  try {
+    const result = await simulateFreeAgentScenario(snapshot, "team-001", {
+      addPlayerId: "fa-rb-001",
+      dropPlayerId: "player-rb-004",
+      period: "2026-W01",
+      samples: 100,
+      seed: 11,
+      dataDir: dir
+    });
+    assert.equal(result.delta.distribution.samples, 100);
+    assert.ok(result.delta.mean > 0);
+    assert.equal(result.delta.distribution.histogram.reduce((sum, bucket) => sum + bucket.count, 0), 100);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
+
+test("analytics rejects an uncovered required starter instead of imputing zero", async () => {
+  const raw = await readFile(resolve("tests/fixtures/sample-football-league.json"), "utf8");
+  const snapshot = JSON.parse(raw) as LeagueSnapshot;
+  const firstStarter = snapshot.league.teams[0]!.roster.starters[0]!.player_id!;
+  const missing = { ...snapshot, projections: snapshot.projections.filter((projection) => projection.player_id !== firstStarter) };
+  const dir = await mkdtemp(join(tmpdir(), "pmt-roster-uncovered-"));
+  try {
+    await assert.rejects(
+      () => buildRosterAnalytics(missing, "team-001", { period: "2026-W01", samples: 10, dataDir: dir }),
+      /required starter .* uncovered .*2026-W01/i
+    );
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
+
+test("optimizer assigns multi-eligible players legally and preserves locked slots", () => {
+  const makeModel = (playerId: string, position: "QB" | "WR", mean: number) => createModel({
+    playerId, playerName: playerId, position, historyMean: mean, historyVar: 1
+  });
+  const models = new Map([
+    ["flex", makeModel("flex", "WR", 40)],
+    ["qb", makeModel("qb", "QB", 30)],
+    ["wr", makeModel("wr", "WR", 12)]
+  ]);
+  const players = [
+    { playerId: "flex", slot: "WR" as PlayerPosition, eligiblePositions: ["QB", "WR"] as PlayerPosition[] },
+    { playerId: "qb", slot: "QB" as PlayerPosition, eligiblePositions: ["QB"] as PlayerPosition[] },
+    { playerId: "wr", slot: "WR" as PlayerPosition, eligiblePositions: ["WR"] as PlayerPosition[] }
+  ];
+  const optimal = optimizeLineup(players, [{ slot: "QB", count: 1 }, { slot: "WR", count: 1 }], models);
+  assert.deepEqual(new Map(optimal.starters.map((starter) => [starter.slot, starter.playerId])), new Map([["QB", "qb"], ["WR", "flex"]]));
+
+  const locked = optimizeLineup([
+    { playerId: "locked", slot: "WR", currentSlot: "WR", locked: true, eligiblePositions: ["WR"] },
+    { playerId: "bench", slot: "WR", currentSlot: "BN", locked: true, eligiblePositions: ["WR"] }
+  ], [{ slot: "WR", count: 1 }], new Map([
+    ["locked", makeModel("locked", "WR", 1)],
+    ["bench", makeModel("bench", "WR", 100)]
+  ]));
+  assert.deepEqual(locked.starters.map((starter) => starter.playerId), ["locked"]);
+});
+
+test("runtime resolver treats padded weekly targets as equivalent and ignores future model state", async () => {
+  const { resolveRuntimeModels } = await import("../src/application/roster-analytics.js");
+  const { writeFile } = await import("node:fs/promises");
+  const snapshot = await completeProjectionSnapshot();
+  const starterId = snapshot.league.teams[0]!.roster.starters[0]!.player_id!;
+  const starter = snapshot.players.find(player => player.player_id === starterId)!;
+  const dir = await mkdtemp(join(tmpdir(), "pmt-causal-state-"));
+  try {
+    const baseline = await resolveRuntimeModels(snapshot, dir, "2026-W1");
+    assert.ok(baseline.has(starterId), "W01 projections cover W1 targets");
+    const model = baseline.get(starterId)!;
+    await writeFile(join(dir, "models.json"), JSON.stringify({ models: [{ ...model, weeksObserved: 3, sigma: 50, lastUpdatedScoringPeriod: "2026-W2" }] }));
+    const resolved = await resolveRuntimeModels(snapshot, dir, "2026-W01");
+    assert.equal(resolved.get(starterId)?.weeksObserved, 0);
+    assert.ok(resolved.get(starterId)!.sigma < 50);
+    assert.equal(resolved.get(starterId)?.position, starter.positions[0]);
+  } finally { await rm(dir, { recursive: true, force: true }); }
+});
