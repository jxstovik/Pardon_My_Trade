PMT_ENV=local
PMT_FIXTURE_PATH=tests/fixtures/sample-football-league.json

# ESPN read/write adapter (feature/DraftKat)
ESPN_LEAGUE_ID=
ESPN_SEASON=2026
ESPN_S2=
SWID=

# Probabilistic model store + action queue (feature/DraftKat)
PMT_DATA_DIR=./data
PMT_PRIORS_PATH=

# External projection sources (optional; comma-separated list).
# When unset, only ESPN is registered with the consensus engine (existing
# behaviour, deterministic tests). Set to "espn,razzball,fftoday" or
# "espn,fantasypros" etc. to opt in.
PMT_PROJECTION_SOURCES=

# Razzball premium credentials (optional). When both are set the CLI runs
# `razzball-login` once and stores a session cookie under
# data/razzball-cookies.json so the premium Pigskinonator / DFS pages are
# reachable. Leave blank to use the free tier only.
RAZZBALL_USERNAME=
RAZZBALL_PASSWORD=

# FantasyPros public API key (optional). Sign up at
# https://www.fantasypros.com/api-data/. When set, requests to
# api.fantasypros.com include `Authorization: Bearer <key>`.
FANTASYPROS_API_KEY=

# Recommendation cache TTL in milliseconds (default 1 hour).
PMT_CACHE_TTL_MS=3600000
