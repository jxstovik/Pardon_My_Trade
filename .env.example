# Pardon My Trade - Environment Configuration

# =============================================================================
# DRAFT HARNESS CONFIGURATION
# =============================================================================
PMT_DRAFT_FORMAT=snake
PMT_DRAFT_TEAMS=12
PMT_DRAFT_TEAM_ID=team-001
PMT_DRAFT_POSITION=1
PMT_DRAFT_FEED=manual
PMT_DRAFT_POLL_MS=15000
# PMT_DRAFT_ESPN_ID=your-espn-draft-id

# =============================================================================
# LLM PROVIDERS (Fallback chain: OpenCode Zen → OpenCode Go → OpenAI)
# =============================================================================

# OpenCode Configuration (used for both zen and go models)
OPENCODE_BASE_URL=https://opencode.ai
OPENCODE_API_KEY=your-opencode-api-key
OPENCODE_ZEN_MODEL=zen
OPENCODE_GO_MODEL=go

# OpenAI Configuration (fallback)
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# =============================================================================
# OLLAMA (Legacy - Optional)
# =============================================================================
# OLLAMA_BASE_URL=https://ollama.cloud
# OLLAMA_MODEL=llama3
# OLLAMA_API_KEY=your-ollama-api-key

# =============================================================================
# OTHER CONFIGURATION
# =============================================================================
PMT_ENV=local
PMT_DATA_DIR=data
PMT_FIXTURE_PATH=tests/fixtures/sample-football-league.json
# PMT_PROJECTION_SOURCES=espn,razzball,fftoday
