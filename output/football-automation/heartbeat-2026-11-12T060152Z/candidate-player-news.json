  {
    "playerId": "5082424",
    "name": "Dominic Zvada",
    "position": [
      "K"
    ],
    "news": [
      {
        "playerId": "5082424",
        "status": "unverified",
        "publishedAt": "2026-11-09T04:01:40.000Z",
        "retrievedAt": "2026-11-12T06:10:27.396Z",
        "sourceUrl": "https://www.espn.com/nfl/player/news/_/id/5082424",
        "text": "Zvada made all four of his field-goal attempts and his lone PAT in Sunday's 19-11 win over the Eagles. After Zvada missed both of his field-goal tries in the Giants' pre-Week 8 bye overtime win over the Texans two weeks ago, coach John Harbaugh stuck with the rookie kicker, and Zvada answered with a perfect afternoon against Philly. Zvada accounted for 13 of the team's 19 points, converting field goals from 53, 49, 38 and 49 yards. On the season, he's 17-for-22 on field-goal tries and 13-for-13 on PATs.",
        "kind": "news"
      }
    ]
  },
  {
    "playerId": "5208518",
    "name": "Charlie Smyth",
    "position": [
      "K"
    ],
    "news": [
      {
        "playerId": "5208518",
        "status": "unverified",
        "publishedAt": "2026-11-10T04:46:21.000Z",
        "retrievedAt": "2026-11-12T06:10:27.589Z",
        "sourceUrl": "https://www.espn.com/nfl/player/news/_/id/5208518",
        "text": "The Saints reverted Smyth to their practice squad Monday, per the NFL's transaction log. Smyth was elevated ahead of Sunday's Week 9 overtime win over Cleveland. He served as New Orleans' kicker in the contest and went 3-for-4 on FGAs while making both of his PAT attempts. That performance was likely good enough for Smyth to be elevated again for this Sunday's matchup against the Panthers.",
        "kind": "news"
      }
    ]
  },
  {
    "playerId": "4362081",
    "name": "Cameron Dicker",
    "position": [
      "K"
    ],
    "news": [
      {
        "playerId": "4362081",
        "status": "unverified",
        "publishedAt": "2026-11-09T04:55:33.000Z",
        "retrievedAt": "2026-11-12T06:10:27.692Z",
        "sourceUrl": "https://www.espn.com/nfl/player/news/_/id/4362081",
        "text": "Dicker went 3-for-3 on field-goal attempts and made his only PAT during Sunday's 44-22 loss to Houston. Dicker was able to make multiple field-goal tries for the third straight game and fifth time this season. The kicker did all his damage in the first half, converting field goals from 52, 33 and 43 yards before the break. Dicker has now gone 15-for-17 on field-goal attempts, including 1-for-2 from 50-plus yards, over eight contests so far during the 2026 campaign.",
        "kind": "news"
      }
    ]
  },
