    "news": [
      {
        "playerId": "4887558",
        "status": "unverified",
        "publishedAt": "2026-11-11T02:28:46.000Z",
        "retrievedAt": "2026-11-14T19:13:55.324Z",
        "sourceUrl": "https://www.espn.com/nfl/player/news/_/id/4887558",
        "text": "Wilson didn't log any snaps during Sunday's win over the Cardinals. Wilson averaged 18.2 carries for 66.7 yards over six games between Week 2 and Week 7, culminating with a 24-100-1 rushing line against Kansas City. However, that opportunity came while Jadarian Price and Zach Charbonnet were on IR. Both running backs returned ahead of the Week 8 matchup against Chicago, and Wilson hasn't played a single offensive snap in two games since. As long as Charbonnet and Price are both healthy, it appears Wilson is going to be relegated primarily to a special-teams role, if he plays at all.",
        "kind": "news"
      }
    ]
